;;basic functions of string processing


;;split the string following the delimiter
to-report explode [delimiter string]
  let res [] let current "" let n length string let i 0
  repeat n [
    ifelse item i string = delimiter [set res lput current res set current ""] [set current word current item i string]
    set i i + 1
  ]
  report lput current res
end

;;concats all elements of the list in one string
to-report implode [l]
  let res ""
  foreach l [? -> set res word res ?]
  report res
end

;;concats all elements of the list in one string inserting the delimiter between them
to-report implode-with-delimiter [l delimiter]
  let res ""
  foreach l [? -> set res (word res ? delimiter)]
  report substring res 0 (length res - 1)
end


to-report replace [string motif new]
  let n length string let i 0 let res ""
  repeat n [ifelse item i string = motif [set res word res new][set res word res item i string] set i i + 1]
  report res
end




to-report as-char-list [string]
  let res [] let i 0
  repeat length string [set res lput item i string res set i i + 1]
  report res
end




;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Basic Stat functions
;;;;;;;;;;;;;;;;;;;;;;;;;;;

; histogram retrieving count list
; nbreaks = number of segments
; reports counts
to-report hist [x nbreaks]
  ifelse x != [] [
  let counts rep 0 nbreaks
  let m min x let ma max x
  foreach x [? -> 
    let index floor ((? - m)/(ma - m)*(nbreaks - 1))
    set counts replace-item index counts (item index counts + 1)
  ]
  
  report counts
  ][
    report []
  ]
end



; quantile function
to-report quantile [x q]
  if length x = 0 [report 0]
  report item (floor (q * length x)) (sort x)
end



;;
; person correlation between two vector
;  \hat{rho} = E(xy)-E(x)E(y)
to-report pearson [x y]
  report mean list-times-element-wise x y - (mean x * mean y)
end




